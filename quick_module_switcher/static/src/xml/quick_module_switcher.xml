<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="quick_module_switcher.QuickModuleSwitcher">
        <Dropdown
            class="'o_quick_module_switcher d-none d-md-flex'"
            togglerClass="'o_quick_module_switcher_toggler px-2'"
            title="'Quick Module Switcher'"
        >
            <t t-set-slot="toggler">
                <i class="fa fa-exchange me-1" title="Switch Module"/>
            </t>

            <t t-if="shortcuts.length">
                <DropdownItem
                    t-foreach="shortcuts"
                    t-as="app"
                    t-key="app.id"
                    class="'o_quick_module_switcher_item'"
                    href="getMenuItemHref(app)"
                    dataset="{ menuXmlid: app.xmlid, section: app.id }"
                    onSelected="() => this.onSelectShortcut(app)"
                >
                    <img class="o_quick_module_switcher_app_icon me-2"
                         t-att-src="getAppIconSrc(app)"
                         t-att-alt="app.name"/>
                    <span t-esc="app.name"/>
                </DropdownItem>
            </t>
            <t t-else="">
                <span class="dropdown-item-text text-muted">No shortcuts configured</span>
            </t>
        </Dropdown>
    </t>
</templates>
