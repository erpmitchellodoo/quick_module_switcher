<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="quick_module_switcher.QuickModuleSwitcher">
        <div class="o_quick_module_switcher d-none d-md-flex">
            <Dropdown position="'bottom-end'">
                <button class="o_quick_module_switcher_toggler px-2 border-0"
                        title="Quick Module Switcher"
                        aria-label="Quick Module Switcher">
                    <i class="fa fa-exchange"/>
                </button>

                <t t-set-slot="content">
                    <t t-if="shortcuts.length">
                        <DropdownItem
                            t-foreach="shortcuts"
                            t-as="app"
                            t-key="app.id"
                            class="'o_quick_module_switcher_item'"
                            onSelected="() => this.onSelectShortcut(app)"
                        >
                            <img class="o_quick_module_switcher_app_icon me-2"
                                 t-att-src="getAppIconSrc(app)"
                                 t-att-alt="app.name"/>
                            <span t-esc="app.name"/>
                        </DropdownItem>
                    </t>
                    <t t-else="">
                        <span class="dropdown-item-text text-muted">No shortcuts configured</span>
                    </t>
                </t>
            </Dropdown>
        </div>
    </t>
</templates>
